@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <div class="container">
        <h1>Get Your Loan Quote in Minutes</h1>
        <p>Fast, simple, and transparent loan applications</p>
        <a asp-controller="Loan" asp-action="Apply" class="btn btn-primary" style="font-size: 1.125rem; padding: 16px 40px; margin-top: 2rem;">
            Apply for a Loan
        </a>
    </div>
</div>

<div class="container my-5">
    <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="color: #424242; font-weight: 400;">Choose Your Product</h2>
        <p style="color: #757575; font-size: 1.125rem;">Select the loan product that best fits your needs</p>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div class="card">
            <div style="text-align: center;">
                <h3 style="color: #00BCD4; font-size: 1.5rem; margin-bottom: 1rem;">Product A</h3>
                <p style="color: #757575; font-size: 1rem; margin-bottom: 1.5rem;">
                    <strong style="color: #424242; font-size: 1.25rem;">Interest-Free</strong><br/>
                    Perfect for short-term needs
                </p>
                <ul style="text-align: left; color: #757575; list-style: none; padding: 0;">
                    <li style="margin-bottom: 0.5rem;">✓ 0% interest rate</li>
                    <li style="margin-bottom: 0.5rem;">✓ Any term length</li>
                    <li style="margin-bottom: 0.5rem;">✓ Lowest monthly payment</li>
                </ul>
            </div>
        </div>
        
        <div class="card">
            <div style="text-align: center;">
                <h3 style="color: #00BCD4; font-size: 1.5rem; margin-bottom: 1rem;">Product B</h3>
                <p style="color: #757575; font-size: 1rem; margin-bottom: 1.5rem;">
                    <strong style="color: #424242; font-size: 1.25rem;">First 2 Months Free</strong><br/>
                    Great for medium-term loans
                </p>
                <ul style="text-align: left; color: #757575; list-style: none; padding: 0;">
                    <li style="margin-bottom: 0.5rem;">✓ 2 months interest-free</li>
                    <li style="margin-bottom: 0.5rem;">✓ 8% annual rate after</li>
                    <li style="margin-bottom: 0.5rem;">✓ Minimum 6 months term</li>
                </ul>
            </div>
        </div>
        
        <div class="card">
            <div style="text-align: center;">
                <h3 style="color: #00BCD4; font-size: 1.5rem; margin-bottom: 1rem;">Product C</h3>
                <p style="color: #757575; font-size: 1rem; margin-bottom: 1.5rem;">
                    <strong style="color: #424242; font-size: 1.25rem;">Standard Rate</strong><br/>
                    Flexible loan option
                </p>
                <ul style="text-align: left; color: #757575; list-style: none; padding: 0;">
                    <li style="margin-bottom: 0.5rem;">✓ 10% annual rate</li>
                    <li style="margin-bottom: 0.5rem;">✓ Any term length</li>
                    <li style="margin-bottom: 0.5rem;">✓ Standard calculation</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div style="background: #FAFAFA; padding: 4rem 0; margin-top: 4rem;">
    <div class="container">
        <div style="text-align: center;">
            <h2 style="color: #424242; font-weight: 400; margin-bottom: 2rem;">How It Works</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 3rem;">
                <div>
                    <div style="width: 60px; height: 60px; background: #00BCD4; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 1.5rem; font-weight: 600;">1</div>
                    <h3 style="font-size: 1.25rem; color: #424242; margin-bottom: 0.5rem;">Calculate Quote</h3>
                    <p style="color: #757575;">Enter your details and get an instant quote</p>
                </div>
                <div>
                    <div style="width: 60px; height: 60px; background: #00BCD4; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 1.5rem; font-weight: 600;">2</div>
                    <h3 style="font-size: 1.25rem; color: #424242; margin-bottom: 0.5rem;">Register or Login</h3>
                    <p style="color: #757575;">Create an account to proceed with your application</p>
                </div>
                <div>
                    <div style="width: 60px; height: 60px; background: #00BCD4; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 1.5rem; font-weight: 600;">3</div>
                    <h3 style="font-size: 1.25rem; color: #424242; margin-bottom: 0.5rem;">Submit Application</h3>
                    <p style="color: #757575;">Review and submit your loan application</p>
                </div>
                <div>
                    <div style="width: 60px; height: 60px; background: #4CAF50; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; color: white; font-size: 1.5rem; font-weight: 600;">✓</div>
                    <h3 style="font-size: 1.25rem; color: #424242; margin-bottom: 0.5rem;">Get Approved</h3>
                    <p style="color: #757575;">Receive approval and access your funds</p>
                </div>
            </div>
        </div>
    </div>
</div>
