@model List<LoanApplicationResponse>
@{
    ViewData["Title"] = "Manage Loan Applications";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container py-8">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #424242; font-weight: 400;">Loan Applications</h2>
        <a asp-action="Dashboard" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>

    <div class="card mb-4">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="LoanApplications"
               class="btn @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-primary")">
                All
            </a>
            <a asp-action="LoanApplications" asp-route-status="Pending"
               class="btn @(currentStatus == "Pending" ? "btn-primary" : "btn-outline-primary")">
                Pending
            </a>
            <a asp-action="LoanApplications" asp-route-status="Approved"
               class="btn @(currentStatus == "Approved" ? "btn-primary" : "btn-outline-primary")">
                Approved
            </a>
            <a asp-action="LoanApplications" asp-route-status="Rejected"
               class="btn @(currentStatus == "Rejected" ? "btn-primary" : "btn-outline-primary")">
                Rejected
            </a>
            <a asp-action="LoanApplications" asp-route-status="Draft"
               class="btn @(currentStatus == "Draft" ? "btn-primary" : "btn-outline-primary")">
                Draft
            </a>
        </div>
    </div>

    <!-- Applications List -->
    @if (!Model.Any())
    {
        <div class="card" style="text-align: center; padding: 4rem 2rem;">
            <div style="font-size: 3rem; color: #00BCD4; margin-bottom: 1rem;">📋</div>
            <p style="color: #757575; font-size: 1.125rem;">
                No loan applications found
            </p>
        </div>
    }
    else
    {
        <div class="card" style="padding: 0;">
            <table class="table mb-0">
                <thead style="background: #f8f9fa;width:500px">
                    <tr>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">APPLICANT</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">AMOUNT</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">PRODUCT</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">STATUS</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">DATE</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;">ACTION</th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;"></th>
                        <th style="padding: 1rem; color: #757575; font-size: 0.875rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr style="border-left: 4px solid @(loan.Status == "Approved" ? "#4CAF50" : loan.Status == "Rejected" ? "#dc3545" : "#00BCD4");">
                            <td style="padding: 1rem;">
                                <div style="color: #424242; font-size: 1.125rem; font-weight: 500;">
                                    @loan.FirstName @loan.LastName
                                </div>
                            </td>
                            <td style="padding: 1rem;">
                                <div style="color: #00BCD4; font-size: 1.5rem; font-weight: 600;">
                                    $@loan.AmountRequired.ToString("N0")
                                </div>
                                <div style="color: #757575; font-size: 0.875rem;">@loan.Term months</div>
                            </td>

                            <td style="padding: 1rem;">
                                <div style="color: #424242; font-weight: 500;">@loan.ProductType</div>
                                <div style="color: #757575; font-size: 0.875rem;">$@loan.MonthlyRepayment.ToString("N2")/mo</div>
                            </td>

                            <td style="padding: 1rem;">
                                <span class="badge @(loan.Status == "Approved" ? "bg-success" : loan.Status == "Rejected" ? "bg-danger" : loan.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                    @loan.Status
                                </span>
                            </td>

                            <td style="padding: 1rem;">
                                <div style="color: #999999; font-size: 0.75rem;">
                                    @loan.CreatedAt.ToString("dd MMM yyyy")
                                </div>
                            </td>

                            <td style="padding: 1rem;">
                                <a asp-controller="Loan" asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            </td>
                            <td style="padding: 1rem;">
                                <form asp-controller="Admin" asp-action="ApproveLoan" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Approve
                                    </button>
                                </form>
                            </td>
                            <td style="padding: 1rem;">
                                <form asp-controller="Admin" asp-action="RejectLoan" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                
                </tbody>
            </table>
        </div>
    }
</div>