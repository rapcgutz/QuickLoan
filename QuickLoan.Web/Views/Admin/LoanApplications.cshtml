@model List<LoanApplicationResponse>
@{
    ViewData["Title"] = "Manage Loan Applications";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #424242; font-weight: 400;">Loan Applications</h2>
        <a asp-action="Dashboard" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>
    
    <!-- Status Filter -->
    <div class="card mb-4">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="LoanApplications" 
               class="btn @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-primary")">
                All
            </a>
            <a asp-action="LoanApplications" asp-route-status="Pending" 
               class="btn @(currentStatus == "Pending" ? "btn-primary" : "btn-outline-primary")">
                Pending
            </a>
            <a asp-action="LoanApplications" asp-route-status="Approved" 
               class="btn @(currentStatus == "Approved" ? "btn-primary" : "btn-outline-primary")">
                Approved
            </a>
            <a asp-action="LoanApplications" asp-route-status="Rejected" 
               class="btn @(currentStatus == "Rejected" ? "btn-primary" : "btn-outline-primary")">
                Rejected
            </a>
            <a asp-action="LoanApplications" asp-route-status="Draft" 
               class="btn @(currentStatus == "Draft" ? "btn-primary" : "btn-outline-primary")">
                Draft
            </a>
        </div>
    </div>
    
    <!-- Applications List -->
    @if (!Model.Any())
    {
        <div class="card" style="text-align: center; padding: 4rem 2rem;">
            <div style="font-size: 3rem; color: #00BCD4; margin-bottom: 1rem;">📋</div>
            <p style="color: #757575; font-size: 1.125rem;">
                No loan applications found
            </p>
        </div>
    }
    else
    {
        <div style="display: grid; gap: 1.5rem;">
            @foreach (var loan in Model)
            {
                <div class="card" style="border-left: 4px solid @(loan.Status == "Approved" ? "#4CAF50" : loan.Status == "Rejected" ? "#dc3545" : "#00BCD4");">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Applicant</div>
                            <div style="color: #424242; font-size: 1.125rem; font-weight: 500;">
                                @loan.FirstName @loan.LastName
                            </div>
                            <div style="color: #757575; font-size: 0.875rem;">@loan.Email</div>
                            <div style="color: #757575; font-size: 0.875rem;">@loan.Mobile</div>
                        </div>
                        
                        <div class="col-md-2">
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Amount</div>
                            <div style="color: #00BCD4; font-size: 1.5rem; font-weight: 600;">
                                $@loan.AmountRequired.ToString("N0")
                            </div>
                            <div style="color: #757575; font-size: 0.875rem;">@loan.Term months</div>
                        </div>
                        
                        <div class="col-md-2">
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Product</div>
                            <div style="color: #424242; font-weight: 500;">@loan.ProductType</div>
                            <div style="color: #757575; font-size: 0.875rem;">$@loan.MonthlyRepayment.ToString("N2")/mo</div>
                        </div>
                        
                        <div class="col-md-2">
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Status</div>
                            <div>
                                <span class="badge @(loan.Status == "Approved" ? "bg-success" : loan.Status == "Rejected" ? "bg-danger" : loan.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                    @loan.Status
                                </span>
                            </div>
                            <div style="color: #999999; font-size: 0.75rem; margin-top: 0.25rem;">
                                @loan.CreatedAt.ToString("dd MMM yyyy")
                            </div>
                        </div>
                        
                        <div class="col-md-3 text-end">
                            @if (loan.Status == "Pending")
                            {
                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal-@loan.Id">
                                    Approve
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@loan.Id">
                                    Reject
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Loan" asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            }
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(loan.AdminNotes))
                    {
                        <div class="mt-3 pt-3" style="border-top: 1px solid #E0E0E0;">
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Admin Notes:</div>
                            <div style="color: #424242; font-size: 0.875rem;">@loan.AdminNotes</div>
                        </div>
                    }
                    
                    <!-- Approve Modal -->
                    <div class="modal fade" id="approveModal-@loan.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="ApproveLoan" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title">Approve Loan Application</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Approve loan for <strong>@loan.FirstName @loan.LastName</strong>?</p>
                                        <div class="mb-3">
                                            <label class="form-label">Admin Notes (Optional)</label>
                                            <textarea name="notes" class="form-control" rows="3" placeholder="Add any notes..."></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-success">Approve</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal-@loan.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="RejectLoan" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loan.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title">Reject Loan Application</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Reject loan for <strong>@loan.FirstName @loan.LastName</strong>?</p>
                                        <div class="mb-3">
                                            <label class="form-label">Reason (Optional)</label>
                                            <textarea name="notes" class="form-control" rows="3" placeholder="Enter rejection reason..."></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Reject</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
