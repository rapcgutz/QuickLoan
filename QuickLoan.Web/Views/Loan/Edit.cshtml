@model UpdateLoanRequest
@{
    ViewData["Title"] = "Edit Loan Application";
    var loanId = ViewBag.LoanId as Guid?;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="quote-calculator-card">
                <h2 class="quote-calculator-title">Edit Loan Application</h2>
                
                <form asp-action="Edit" asp-route-id="@loanId" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <!-- Amount Required Slider -->
                    <div class="range-slider-container">
                        <div class="text-center">
                            <span class="range-value" id="amountDisplay">$@Model.AmountRequired.ToString("N0")</span>
                        </div>
                        <input type="range" 
                               class="range-slider" 
                               id="amountSlider"
                               asp-for="AmountRequired"
                               min="2100" 
                               max="15000" 
                               step="100" 
                               value="@Model.AmountRequired"
                               oninput="updateAmount(this.value)" />
                        <div class="range-labels">
                            <span>$2,100</span>
                            <span style="color: #757575;">How much do you need?</span>
                            <span>$15,000</span>
                        </div>
                        <span asp-validation-for="AmountRequired" class="text-danger"></span>
                    </div>
                    
                    <!-- Term Selector -->
                    <div class="mb-4">
                        <label asp-for="Term" class="form-label">Loan term (months)</label>
                        <select asp-for="Term" class="form-control form-select">
                            <option value="6">6 months</option>
                            <option value="12">12 months</option>
                            <option value="18">18 months</option>
                            <option value="24">24 months</option>
                            <option value="36">36 months</option>
                        </select>
                        <span asp-validation-for="Term" class="text-danger"></span>
                    </div>
                    
                    <!-- Product Type -->
                    <div class="mb-4">
                        <label asp-for="ProductType" class="form-label">Product type</label>
                        <select asp-for="ProductType" class="form-control form-select">
                            <option value="ProductA">Product A - Interest Free</option>
                            <option value="ProductB">Product B - First 2 Months Free</option>
                            <option value="ProductC">Product C - Standard</option>
                        </select>
                        <span asp-validation-for="ProductType" class="text-danger"></span>
                    </div>
                    
                    <div class="alert alert-info">
                        <strong>Note:</strong> Personal information cannot be changed. If you need to update your name, email, or date of birth, please contact support.
                    </div>
                    
                    <!-- Buttons -->
                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Details" asp-route-id="@loanId" class="btn btn-outline-primary">Cancel</a>
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.7/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function updateAmount(value) {
            document.getElementById('amountDisplay').textContent = '$' + parseInt(value).toLocaleString();
            
            // Update slider background gradient
            const slider = document.getElementById('amountSlider');
            const percentage = ((value - slider.min) / (slider.max - slider.min)) * 100;
            slider.style.background = `linear-gradient(to right, #00BCD4 0%, #00BCD4 ${percentage}%, #E0E0E0 ${percentage}%, #E0E0E0 100%)`;
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('amountSlider');
            updateAmount(slider.value);
        });
    </script>
}
