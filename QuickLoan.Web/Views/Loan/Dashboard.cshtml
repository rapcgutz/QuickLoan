@model List<LoanApplicationResponse>
@{
    ViewData["Title"] = "My Loans";
}

<div class="container" style="padding: 3rem 0;">
    <h2 style="color: #424242; font-weight: 400; margin-bottom: 2rem;">My Loan Applications</h2>
    
    @if (Model == null || !Model.Any())
    {
        <div class="card" style="text-align: center; padding: 4rem 2rem;">
            <p style="color: #757575; font-size: 1.125rem; margin-bottom: 2rem;">
                You don't have any loan applications yet.
            </p>
            <a asp-action="Apply" class="btn btn-primary">Apply for a Loan</a>
        </div>
    }
    else
    {
        <div style="display: grid; gap: 1.5rem;">
            @foreach (var loan in Model)
            {
                <div class="card" style="border-left: 4px solid @(loan.Status == "Approved" ? "#4CAF50" : loan.Status == "Rejected" ? "#dc3545" : "#00BCD4");">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 2rem; align-items: center;">
                        <div>
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Amount</div>
                            <div style="color: #00BCD4; font-size: 1.5rem; font-weight: 600;">
                                $@loan.AmountRequired.ToString("N0")
                            </div>
                            <div style="color: #757575; font-size: 0.875rem;">over @loan.Term months</div>
                        </div>
                        
                        <div>
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Monthly Payment</div>
                            <div style="color: #424242; font-size: 1.25rem; font-weight: 500;">
                                $@loan.MonthlyRepayment.ToString("N2")
                            </div>
                        </div>
                        
                        <div>
                            <div style="color: #757575; font-size: 0.875rem; margin-bottom: 0.25rem;">Status</div>
                            <div>
                                <span style="
                                    padding: 4px 12px; 
                                    border-radius: 12px; 
                                    font-size: 0.875rem; 
                                    font-weight: 500;
                                    background: @(loan.Status == "Approved" ? "#d4edda" : loan.Status == "Rejected" ? "#f8d7da" : "#d1ecf1");
                                    color: @(loan.Status == "Approved" ? "#155724" : loan.Status == "Rejected" ? "#721c24" : "#0c5460");">
                                    @loan.Status
                                </span>
                            </div>
                        </div>
                        
                        <div>
                            <a asp-action="Details" asp-route-id="@loan.Id" class="btn btn-outline-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                    
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #E0E0E0; color: #999999; font-size: 0.875rem;">
                        Applied: @loan.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                </div>
            }
        </div>
    }
</div>
