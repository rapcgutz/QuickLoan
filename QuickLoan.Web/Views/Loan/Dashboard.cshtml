@model List<LoanApplicationResponse>
@{
    ViewData["Title"] = "My Loans";
}

<div class="container" style="padding: 3rem 0;">
    @if (Model == null || !Model.Any())
    {
        <div class="card" style="text-align: center; padding: 4rem 2rem;">
            <p style="color: #757575; font-size: 1.125rem; margin-bottom: 2rem;">
                You don't have any loan applications yet.
            </p>
            <a asp-action="Apply" class="btn btn-primary">Apply for a Loan</a>
        </div>
    }
    else
    {

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h2 style="color: #424242; font-weight: 400; margin: 0;">My Loan Applications</h2>
            <a asp-action="Apply" class="btn btn-primary">Apply for New Loan</a>
        </div>

        <div class="card" style="padding: 0; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead style="background: #f5f5f5; border-bottom: 2px solid #e0e0e0;">
                    <tr>
                        <th style="padding: 1rem; text-align: left; color: #757575; font-weight: 600; font-size: 0.875rem;">APPLICATION DATE</th>
                        <th style="padding: 1rem; text-align: left; color: #757575; font-weight: 600; font-size: 0.875rem;">LOAN AMOUNT</th>
                        <th style="padding: 1rem; text-align: left; color: #757575; font-weight: 600; font-size: 0.875rem;">TERM</th>
                        <th style="padding: 1rem; text-align: left; color: #757575; font-weight: 600; font-size: 0.875rem;">MONTHLY PAYMENT</th>
                        <th style="padding: 1rem; text-align: left; color: #757575; font-weight: 600; font-size: 0.875rem;">STATUS</th>
                        <th style="padding: 1rem; text-align: center; color: #757575; font-weight: 600; font-size: 0.875rem;">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr style="border-bottom: 1px solid #e0e0e0; cursor: pointer; transition: background 0.2s;"
                            onmouseover="this.style.background='#fafafa'"
                            onmouseout="this.style.background='white'"
                            onclick="window.location.href='@Url.Action("Details", new { id = loan.Id })'">

                            <td style="padding: 1rem; color: #424242;">
                                @loan.CreatedAt.ToString("MMM dd, yyyy")
                            </td>

                            <td style="padding: 1rem;">
                                <div style="color: #00BCD4; font-size: 1.125rem; font-weight: 600;">
                                    $@loan.AmountRequired.ToString("N0")
                                </div>
                            </td>

                            <td style="padding: 1rem; color: #424242;">
                                @loan.Term months
                            </td>

                            <td style="padding: 1rem;">
                                <div style="color: #424242; font-weight: 500;">
                                    $@loan.MonthlyRepayment.ToString("N2")
                                </div>
                            </td>

                            <td style="padding: 1rem;">
                                <span style="
                                            padding: 6px 14px;
                                            border-radius: 14px;
                                            font-size: 0.8125rem;
                                            font-weight: 500;
                                            display: inline-block;
                                            background: @(loan.Status == "Approved" ? "#d4edda" : loan.Status == "Rejected" ? "#f8d7da" : "#d1ecf1");
                                            color: @(loan.Status == "Approved" ? "#155724" : loan.Status == "Rejected" ? "#721c24" : "#0c5460");">
                                    @loan.Status
                                </span>
                            </td>

                            <td style="padding: 1rem; text-align: center;">
                                <a asp-action="Details" asp-route-id="@loan.Id"
                                   class="btn btn-outline-primary btn-sm"
                                   onclick="event.stopPropagation();">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }

    table tr {
        transition: background-color 0.2s ease;
    }
</style>