@model LoanApplicationResponse
@{
    ViewData["Title"] = "Loan Details";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="quote-result-card">
                <h2 class="quote-result-title">Loan Application Details</h2>
                
                <!-- Status Badge -->
                <div class="text-center mb-4">
                    <span class="badge @(Model.Status == "Approved" ? "bg-success" : Model.Status == "Rejected" ? "bg-danger" : Model.Status == "Draft" ? "bg-secondary" : "bg-info") fs-5 px-4 py-2">
                        @Model.Status
                    </span>
                </div>

                <!-- Your Information -->
                <div class="info-section">
                    <div class="section-header">
                        <span class="section-title">Your information</span>
                        @if (Model.Status == "Draft")
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="edit-link">Edit</a>
                        }
                    </div>
                    <div class="info-row">
                        <span class="info-label">Name</span>
                        <span class="info-value">@Model.Title @Model.FirstName @Model.LastName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Mobile</span>
                        <span class="info-value">@Model.Mobile</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Date of Birth</span>
                        <span class="info-value">@Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <!-- Finance Details -->
                <div class="info-section">
                    <div class="section-header">
                        <span class="section-title">Finance details</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Finance amount</span>
                        <div class="text-end">
                            <span class="info-value-highlight">$@Model.AmountRequired.ToString("N0")</span>
                            <span class="info-value-small">over @Model.Term months</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Product type</span>
                        <span class="info-value">@Model.ProductType</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Monthly repayment</span>
                        <div class="text-end">
                            <span class="info-value-highlight">$@Model.MonthlyRepayment.ToString("N2")</span>
                            <span class="info-value-small">per month</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Establishment fee</span>
                        <span class="info-value">$@Model.EstablishmentFee.ToString("N2")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Total interest</span>
                        <span class="info-value">$@Model.TotalInterest.ToString("N2")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Total repayment</span>
                        <span class="info-value fw-bold">$@Model.TotalRepayment.ToString("N2")</span>
                    </div>
                </div>

                <!-- Application Info -->
                <div class="info-section">
                    <div class="section-header">
                        <span class="section-title">Application information</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Application ID</span>
                        <span class="info-value" style="font-family: monospace; font-size: 0.875rem;">@Model.Id</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Created</span>
                        <span class="info-value">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    @if (Model.SubmittedAt.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label">Submitted</span>
                            <span class="info-value">@Model.SubmittedAt.Value.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    }
                    @if (Model.Status == "Approved" || Model.Status == "Rejected")
                    {
                        <div class="info-row">
                            <span class="info-label">Processed</span>
                            <span class="info-value">@Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.AdminNotes))
                    {
                        <div class="mt-3">
                            <span class="info-label d-block mb-2">Admin Notes</span>
                            <div class="alert alert-info mb-0">@Model.AdminNotes</div>
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div class="mt-4">
                    <a asp-action="Dashboard" class="btn btn-outline-primary">Back to My Loans</a>
                    @if (Model.Status == "Draft")
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Application</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
