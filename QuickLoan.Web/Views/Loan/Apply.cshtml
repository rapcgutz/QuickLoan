@model QuotationRequest
@{
    ViewData["Title"] = "Apply for Loan";
}

<div class="container" style="padding: 3rem 0;">
    <div class="quote-calculator-card">
        <h2 class="quote-calculator-title">Quote calculator</h2>
        
        <form asp-action="Apply" method="post" id="quotationForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <!-- Amount Required Slider -->
            <div class="range-slider-container">
                <div style="text-align: center;">
                    <span class="range-value" id="amountDisplay">$5,000</span>
                </div>
                <input type="range" 
                       class="range-slider" 
                       id="amountSlider"
                       asp-for="AmountRequired"
                       min="2100" 
                       max="15000" 
                       step="100" 
                       value="5000"
                       oninput="updateAmount(this.value)" />
                <div class="range-labels">
                    <span>$2,100</span>
                    <span style="color: #757575;">How much do you need?</span>
                    <span>$15,000</span>
                </div>
            </div>
            
            <!-- Term Selector -->
            <div class="mb-4">
                <label asp-for="Term" class="form-label">Loan term (months)</label>
                <select asp-for="Term" class="form-control form-select">
                    <option value="6">6 months</option>
                    <option value="12" selected>12 months</option>
                    <option value="18">18 months</option>
                    <option value="24">24 months</option>
                    <option value="36">36 months</option>
                </select>
            </div>
            
            <!-- Product Type -->
            <div class="mb-4">
                <label asp-for="ProductType" class="form-label">Product type</label>
                <select asp-for="ProductType" class="form-control form-select">
                    <option value="ProductA">Product A - Interest Free</option>
                    <option value="ProductB">Product B - First 2 Months Free</option>
                    <option value="ProductC" selected>Product C - Standard</option>
                </select>
            </div>
            
            <!-- Personal Information -->
            <div style="display: grid; grid-template-columns: 100px 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <label asp-for="Title" class="form-label">Title</label>
                    <select asp-for="Title" class="form-control form-select">
                        <option value="Mr">Mr.</option>
                        <option value="Mrs">Mrs.</option>
                        <option value="Ms">Ms.</option>
                        <option value="Dr">Dr.</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" style="color: transparent;">.</label>
                    <input asp-for="FirstName" class="form-control" placeholder="First name" />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size: 0.875rem;"></span>
                </div>
                <div>
                    <label class="form-label" style="color: transparent;">.</label>
                    <input asp-for="LastName" class="form-control" placeholder="Last name" />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size: 0.875rem;"></span>
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <input asp-for="Email" class="form-control" placeholder="Your email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 0.875rem;"></span>
                </div>
                <div>
                    <input asp-for="Mobile" class="form-control" placeholder="Mobile number" />
                    <span asp-validation-for="Mobile" class="text-danger" style="font-size: 0.875rem;"></span>
                </div>
            </div>
            
            <!-- Hidden DateOfBirth -->
            <input asp-for="DateOfBirth" type="hidden" value="@DateTime.Today.AddYears(-25).ToString("yyyy-MM-dd")" />
            
            <!-- Calculate Button -->
            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 2rem;">
                Calculate quote
            </button>
            
            <p class="disclaimer">
                Quote does not affect your credit score
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function updateAmount(value) {
            document.getElementById('amountDisplay').textContent = '$' + parseInt(value).toLocaleString();
            
            // Update slider background gradient
            const slider = document.getElementById('amountSlider');
            const percentage = ((value - slider.min) / (slider.max - slider.min)) * 100;
            slider.style.background = `linear-gradient(to right, #00BCD4 0%, #00BCD4 ${percentage}%, #E0E0E0 ${percentage}%, #E0E0E0 100%)`;
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('amountSlider');
            updateAmount(slider.value);
        });
    </script>
}
