<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickLoan</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        QuickLoan
                    </a>
                    <div style="display: flex; gap: 2rem; align-items: center;">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-link" asp-controller="Loan" asp-action="Apply">Apply Now</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link" asp-controller="Loan" asp-action="Dashboard">My Loans</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Panel</a>
                            }
                            <span class="nav-link">Welcome, @User.Identity.Name</span>
                            <a class="nav-link btn btn-outline-primary" asp-controller="Auth" asp-action="Logout" style="padding: 8px 20px;">Logout</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                            <a class="btn btn-primary" asp-controller="Auth" asp-action="Register" style="padding: 8px 20px;">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 QuickLoan - All Rights Reserved</p>
            <p class="text-muted" style="font-size: 0.875rem;">
                Quote does not affect your credit score
            </p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

        fetch('/Time/SetTimeZone', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ timeZone })
        });
    </script>
</body>
</html>
